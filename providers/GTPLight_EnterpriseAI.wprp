            <EventProviderId Value="EventProvider_EnterpriseAI_WindowsSearchCore" />
            <EventProviderId Value="EventProvider_EnterpriseAI_AIFabric" />
            <EventProviderId Value="EventProvider_EnterpriseAI_AIFabricTelemetry" />
            <EventProviderId Value="EventProvider_EnterpriseAI_ONNX" />
