    <EventProvider Id="EventProvider_EnterpriseAI_PerceptiveShell" Name="45aa7ae8-974c-5bbd-d7b5-8ea567dac172" NonPagedMemory="true" Level="5" />
    <Profile Id="EnterpriseAI.Verbose.File" Name="EnterpriseAI" Description="Light memory/hard faults, foreground PTs, and native AI observations" LoggingMode="File" DetailLevel="Verbose" Default="true">
      <ProblemCategories>
        <ProblemCategory Value="First Level Triage" />
      </ProblemCategories>
      <Collectors>
        <SystemCollectorId Value="SystemCollector_EnterpriseAI">
          <SystemProviderId Value="SystemProvider_EnterpriseAI_Light" />
        </SystemCollectorId>
        <EventCollectorId Value="EventCollector_EnterpriseAI">
          <EventProviders>
            <EventProviderId Value="EventProvider_EnterpriseAI_PerfTrack" />
            <EventProviderId Value="EventProvider_EnterpriseAI_UTC" />
            <EventProviderId Value="EventProvider_EnterpriseAI_TIP" />
            <EventProviderId Value="EventProvider_EnterpriseAI_InputInject" />
