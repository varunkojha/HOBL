<?xml version="1.0" encoding="utf-8"?>
<WindowsPerformanceRecorder Author="HOBL Enterprise AI" Version="1">
  <Profiles>
    <SystemCollector Id="SystemCollector_EnterpriseAI" Name="EnterpriseAI_KernelLogger" HostGuestCorrelation="true">
      <BufferSize Value="2048" />
      <Buffers Value="40" />
    </SystemCollector>
    <EventCollector Id="EventCollector_EnterpriseAI" Name="EnterpriseAI_EventLogger" HostGuestCorrelation="true">
      <BufferSize Value="1024" />
      <Buffers Value="10" />
    </EventCollector>
    <SystemProvider Id="SystemProvider_EnterpriseAI_Light">
      <Keywords>
        <Keyword Value="MemoryInfo" />
        <Keyword Value="MemoryInfoWS" />
        <Keyword Value="HardFaults" />
        <Keyword Value="ProcessThread" />
        <Keyword Value="Loader" />
      </Keywords>
    </SystemProvider>
    <EventProvider Id="EventProvider_EnterpriseAI_PerfTrack" Name="PerfTrack" NonPagedMemory="true" Level="4" />
    <EventProvider Id="EventProvider_EnterpriseAI_UTC" Name="UTC" NonPagedMemory="true" Level="4" />
    <EventProvider Id="EventProvider_EnterpriseAI_TIP" Name="50109fbd-6d85-5815-731e-c907eca1607b" NonPagedMemory="true" Level="5" EventKey="true" />
