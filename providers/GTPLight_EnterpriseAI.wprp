      <CaptureStateOnStart>
        <Keyword Value="0x1" />
      </CaptureStateOnStart>
      <CaptureStateOnSave>
        <Keyword Value="0x1" />
      </CaptureStateOnSave>
    </EventProvider>
    <EventProvider Id="EventProvider_EnterpriseAI_ORT" Name="3a26b1ff-7484-7484-7484-15261f42614d" NonPagedMemory="true" Level="5" />
    <EventProvider Id="EventProvider_EnterpriseAI_WinML" Name="d766d9ff-112c-4dac-9247-241cf99d123f" NonPagedMemory="true" Level="5" />
