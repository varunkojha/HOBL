    <EventProvider Id="EventProvider_EnterpriseAI_ShellCore" Name="30336ed4-e327-447c-9de0-51b652c86108" NonPagedMemory="true" Level="5">
      <Keywords>
        <Keyword Value="0x1000000000000" />
      </Keywords>
    </EventProvider>
    <!-- AI event schemas, default keyword coverage, and capture overhead require DUT validation. -->
    <EventProvider Id="EventProvider_EnterpriseAI_WindowsSearchCore" Name="49c2c27c-fe2d-40bf-8c4e-c3fb518037e7" NonPagedMemory="true" Level="5" />
    <EventProvider Id="EventProvider_EnterpriseAI_AIFabric" Name="434877dc-e809-46b5-9168-38c27e6e332e" NonPagedMemory="true" Level="5" />
